# Solo variables públicas: se incrustan en el bundle (web y APK). Nunca pongas secretos aquí.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# URL base de apps/api (sin / final)
EXPO_PUBLIC_API_URL=http://localhost:8787
# owner/repo de GitHub donde se publican los releases con el APK (auto-update)
EXPO_PUBLIC_GITHUB_REPO=luiscruzga/lukita
# Clave pública VAPID para Web Push (la privada vive solo en apps/api)
EXPO_PUBLIC_VAPID_PUBLIC_KEY=
# API key de CARTO para las teselas del mapa (gratis: https://carto.com/basemaps/apikey). Es pública.
EXPO_PUBLIC_CARTO_KEY=
# Opcional: URL del sitio web público (para compartir enlaces)
EXPO_PUBLIC_SITE_URL=http://localhost:8098
